    <!-- Modal Edit Produk & Kategori -->
    <div class="modal-overlay" id="admin-edit-price-modal">
        <div class="modal" style="max-width: 520px;">
            <div class="modal-header">
                <h3><i class="fas fa-edit" style="color:var(--accent-start)"></i> Ubah Data Produk & Kategori</h3>
                <button type="button" class="modal-close" data-modal-close><i class="fas fa-times"></i></button>
            </div>
            <div class="modal-body">
                <form id="admin-edit-price-form">
                    <input type="hidden" id="edit-prod-id">
                    <div class="form-group">
                        <label for="edit-prod-name">Nama Produk Cetak <span class="required">*</span></label>
                        <input type="text" id="edit-prod-name" required>
                    </div>
                    <div style="display:grid; grid-template-columns: 1fr 1fr; gap:0.75rem;">
                        <div class="form-group">
                            <label for="edit-prod-cat">Kategori Produk <span class="required">*</span></label>
                            <select id="edit-prod-cat" required style="width:100%; padding:0.85rem; border:2px solid var(--border-color); border-radius:var(--radius-md); background:var(--bg-card); color:var(--text-primary); font-weight:600;"></select>
                        </div>
                        <div class="form-group">
                            <label for="edit-prod-badge">Badge Label</label>
                            <select id="edit-prod-badge" style="width:100%; padding:0.85rem; border:2px solid var(--border-color); border-radius:var(--radius-md); background:var(--bg-card); color:var(--text-primary); font-weight:600;">
                                <option value="hot">HOT (Terlaris)</option>
                                <option value="new">NEW (Baru)</option>
                                <option value="sale">SALE (Promo)</option>
                                <option value="">Tanpa Badge</option>
                            </select>
                        </div>
                    </div>
                    <div style="display:grid; grid-template-columns: 1.5fr 1fr; gap:0.75rem;">
                        <div class="form-group">
                            <label for="edit-prod-price">Harga Satuan Baru (Rp) <span class="required">*</span></label>
                            <input type="number" id="edit-prod-price" min="500" step="500" required>
                        </div>
                        <div class="form-group">
                            <label for="edit-prod-unit">Satuan Hitungan</label>
                            <input type="text" id="edit-prod-unit" required placeholder="m2 / lembar / pcs">
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="edit-prod-time">Waktu Produksi</label>
                        <input type="text" id="edit-prod-time" placeholder="1 - 2 Jam">
                    </div>
                    <div class="form-group">
                        <label for="edit-prod-desc">Deskripsi Layanan</label>
                        <textarea id="edit-prod-desc" rows="3"></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary btn-block btn-lg" style="margin-top:1rem; font-weight:800;">
                        <i class="fas fa-save"></i> Simpan Perubahan Produk & Kategori
                    </button>
                </form>
            </div>
        </div>
    </div>


