    <!-- Modal Penyesuaian Angka Finansial (Master Admin) -->
    <div class="modal-overlay" id="modal-financial-override">
        <div class="modal" style="max-width: 780px; max-height: 90vh; overflow-y: auto;">
            <div class="modal-header">
                <div>
                    <h3 class="modal-title" style="display:flex; align-items:center; gap:0.5rem;">
                        <i class="fas fa-sliders-h" style="color:#6366f1;"></i> Atur & Sesuaikan Angka Finansial
                    </h3>
                    <p style="font-size:0.8rem; color:var(--text-secondary); margin:0.25rem 0 0 0;">
                        Khusus Master Admin: Sesuaikan nominal omset, kas masuk, piutang, dan saluran transaksi untuk pembukuan khusus atau demo.
                    </p>
                </div>
                <button type="button" class="modal-close" onclick="UI.closeModal('modal-financial-override')">&times;</button>
            </div>
            <div class="modal-body" style="padding:1.25rem;">
                <!-- Status Mode Aktif Switch -->
                <div style="background:var(--bg-secondary); border:1px solid var(--border-color); border-radius:var(--radius-md); padding:1rem; margin-bottom:1.25rem; display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:1rem;">
                    <div>
                        <div style="font-weight:800; font-size:0.95rem; color:var(--text-primary); display:flex; align-items:center; gap:0.5rem;">
                            <span>Status Tampilan:</span>
                            <span id="override-status-pill" class="badge" style="background:rgba(16,185,129,0.15); color:#10b981; border:1px solid #10b981;">Mode Otomatis (Database Transaksi)</span>
                        </div>
                        <div style="font-size:0.8rem; color:var(--text-secondary); margin-top:0.25rem;">
                            Aktifkan toggle di sebelah kanan untuk menerapkan angka penyesuaian khusus Anda ke seluruh kartu metrik & dokumen cetak.
                        </div>
                    </div>
                    <div style="display:flex; align-items:center; gap:0.75rem;">
                        <label class="switch-toggle">
                            <input type="checkbox" id="override-enabled-toggle">
                            <span class="slider"></span>
                        </label>
                        <span id="override-toggle-label" style="font-size:0.85rem; font-weight:700; color:var(--text-primary);">Gunakan Nilai Kustom</span>
                    </div>
                </div>

                <!-- Tombol Pintas Preset Cepat -->
                <div style="margin-bottom:1.25rem; background:rgba(99,102,241,0.06); border:1px solid rgba(99,102,241,0.25); border-radius:var(--radius-md); padding:0.85rem;">
                    <div style="font-size:0.8rem; font-weight:800; color:#a5b4fc; margin-bottom:0.5rem; text-transform:uppercase; letter-spacing:0.5px; display:flex; align-items:center; gap:0.4rem;">
                        <i class="fas fa-magic"></i> Tombol Pintas Preset Cepat (1-Klik Isi Form)
                    </div>
                    <div style="display:flex; gap:0.5rem; flex-wrap:wrap;">
                        <button type="button" class="btn btn-outline btn-sm" id="btn-preset-copy-db" style="font-size:0.78rem;">
                            <i class="fas fa-copy"></i> Salin Nilai Database Saat Ini
                        </button>
                        <button type="button" class="btn btn-outline btn-sm" id="btn-preset-active-shop" style="font-size:0.78rem;">
                            <i class="fas fa-store"></i> Preset Toko Aktif (~Rp 1,5 Juta)
                        </button>
                        <button type="button" class="btn btn-outline btn-sm" id="btn-preset-big-tender" style="font-size:0.78rem;">
                            <i class="fas fa-building"></i> Preset Skala Besar (~Rp 8,5 Juta)
                        </button>
                    </div>
                </div>

                <form id="form-financial-override">
                    <!-- Section 1: 4 Metrik Kartu Utama -->
                    <div style="margin-bottom:1.25rem;">
                        <h4 style="font-size:0.85rem; font-weight:800; color:#818cf8; margin-bottom:0.75rem; text-transform:uppercase; display:flex; align-items:center; gap:0.4rem;">
                            <i class="fas fa-chart-pie"></i> 1. Metrik 4 Kartu Utama Dashboard
                        </h4>
                        <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(220px, 1fr)); gap:0.85rem;">
                            <div>
                                <label style="display:block; font-size:0.8rem; font-weight:700; margin-bottom:0.25rem;">Total Nilai Pesanan / Omset Bruto (Rp)</label>
                                <input type="number" id="override-input-total-rev" required min="0" step="1000" class="form-control" style="width:100%; padding:0.6rem; border:1px solid var(--border-color); border-radius:var(--radius-md); background:var(--bg-secondary); color:var(--text-primary); font-weight:700;">
                            </div>
                            <div>
                                <label style="display:block; font-size:0.8rem; font-weight:700; margin-bottom:0.25rem;">Kas Masuk Nyata / Real Cash In (Rp)</label>
                                <input type="number" id="override-input-cash-in" required min="0" step="1000" class="form-control" style="width:100%; padding:0.6rem; border:1px solid var(--border-color); border-radius:var(--radius-md); background:var(--bg-secondary); color:var(--text-primary); font-weight:700;">
                            </div>
                            <div>
                                <label style="display:block; font-size:0.8rem; font-weight:700; margin-bottom:0.25rem;">Sisa Piutang DP Belum Lunas (Rp)</label>
                                <input type="number" id="override-input-pending-bal" required min="0" step="1000" class="form-control" style="width:100%; padding:0.6rem; border:1px solid var(--border-color); border-radius:var(--radius-md); background:var(--bg-secondary); color:var(--text-primary); font-weight:700;">
                            </div>
                            <div>
                                <label style="display:block; font-size:0.8rem; font-weight:700; margin-bottom:0.25rem;">Total Pesanan & Rata-rata AOV</label>
                                <div style="display:flex; gap:0.5rem;">
                                    <input type="number" id="override-input-order-count" placeholder="Jml Order" required min="0" class="form-control" style="width:40%; padding:0.6rem; border:1px solid var(--border-color); border-radius:var(--radius-md); background:var(--bg-secondary); color:var(--text-primary); font-weight:700;">
                                    <input type="number" id="override-input-aov" placeholder="AOV (Rp)" required min="0" step="500" class="form-control" style="width:60%; padding:0.6rem; border:1px solid var(--border-color); border-radius:var(--radius-md); background:var(--bg-secondary); color:var(--text-primary); font-weight:700;">
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Section 2: Komparasi Saluran Offline vs Online -->
                    <div style="border-top:1px dashed var(--border-color); padding-top:1rem; margin-bottom:1.25rem;">
                        <h4 style="font-size:0.85rem; font-weight:800; color:#818cf8; margin-bottom:0.75rem; text-transform:uppercase; display:flex; align-items:center; gap:0.4rem;">
                            <i class="fas fa-store-alt"></i> 2. Komparasi Saluran Penjualan
                        </h4>
                        <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(220px, 1fr)); gap:0.85rem;">
                            <div>
                                <label style="display:block; font-size:0.8rem; font-weight:700; margin-bottom:0.25rem;">Pendapatan Offline Kasir (Rp)</label>
                                <input type="number" id="override-input-offline-rev" required min="0" step="1000" class="form-control" style="width:100%; padding:0.6rem; border:1px solid var(--border-color); border-radius:var(--radius-md); background:var(--bg-secondary); color:var(--text-primary); font-weight:700;">
                            </div>
                            <div>
                                <label style="display:block; font-size:0.8rem; font-weight:700; margin-bottom:0.25rem;">Pendapatan Online Web (Rp)</label>
                                <input type="number" id="override-input-online-rev" required min="0" step="1000" class="form-control" style="width:100%; padding:0.6rem; border:1px solid var(--border-color); border-radius:var(--radius-md); background:var(--bg-secondary); color:var(--text-primary); font-weight:700;">
                            </div>
                        </div>
                    </div>

                    <!-- Section 3: Realisasi 4 Saluran Pembayaran (Kas Masuk) -->
                    <div style="border-top:1px dashed var(--border-color); padding-top:1rem; margin-bottom:1.5rem;">
                        <h4 style="font-size:0.85rem; font-weight:800; color:#818cf8; margin-bottom:0.75rem; text-transform:uppercase; display:flex; align-items:center; gap:0.4rem;">
                            <i class="fas fa-credit-card"></i> 3. Realisasi Saluran Pembayaran (Kas Masuk)
                        </h4>
                        <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(170px, 1fr)); gap:0.85rem;">
                            <!-- QRIS -->
                            <div style="background:var(--bg-secondary); border:1px solid var(--border-color); border-radius:var(--radius-md); padding:0.75rem;">
                                <div style="font-weight:700; font-size:0.85rem; color:#38bdf8; margin-bottom:0.35rem;">
                                    <i class="fas fa-qrcode"></i> QRIS Digital
                                </div>
                                <div style="display:flex; flex-direction:column; gap:0.35rem;">
                                    <input type="number" id="override-input-qris-total" placeholder="Nominal Rp" min="0" step="1000" class="form-control" style="width:100%; padding:0.5rem; border:1px solid var(--border-color); border-radius:var(--radius-sm); background:var(--bg-card); color:var(--text-primary); font-size:0.85rem;">
                                    <input type="number" id="override-input-qris-count" placeholder="Jml Transaksi" min="0" class="form-control" style="width:100%; padding:0.5rem; border:1px solid var(--border-color); border-radius:var(--radius-sm); background:var(--bg-card); color:var(--text-primary); font-size:0.85rem;">
                                </div>
                            </div>
                            <!-- Tunai -->
                            <div style="background:var(--bg-secondary); border:1px solid var(--border-color); border-radius:var(--radius-md); padding:0.75rem;">
                                <div style="font-weight:700; font-size:0.85rem; color:#10b981; margin-bottom:0.35rem;">
                                    <i class="fas fa-money-bill-wave"></i> Tunai / Cash Kasir
                                </div>
                                <div style="display:flex; flex-direction:column; gap:0.35rem;">
                                    <input type="number" id="override-input-cash-total" placeholder="Nominal Rp" min="0" step="1000" class="form-control" style="width:100%; padding:0.5rem; border:1px solid var(--border-color); border-radius:var(--radius-sm); background:var(--bg-card); color:var(--text-primary); font-size:0.85rem;">
                                    <input type="number" id="override-input-cash-count" placeholder="Jml Transaksi" min="0" class="form-control" style="width:100%; padding:0.5rem; border:1px solid var(--border-color); border-radius:var(--radius-sm); background:var(--bg-card); color:var(--text-primary); font-size:0.85rem;">
                                </div>
                            </div>
                            <!-- Bank -->
                            <div style="background:var(--bg-secondary); border:1px solid var(--border-color); border-radius:var(--radius-md); padding:0.75rem;">
                                <div style="font-weight:700; font-size:0.85rem; color:#6366f1; margin-bottom:0.35rem;">
                                    <i class="fas fa-university"></i> Transfer Bank Virtual
                                </div>
                                <div style="display:flex; flex-direction:column; gap:0.35rem;">
                                    <input type="number" id="override-input-bank-total" placeholder="Nominal Rp" min="0" step="1000" class="form-control" style="width:100%; padding:0.5rem; border:1px solid var(--border-color); border-radius:var(--radius-sm); background:var(--bg-card); color:var(--text-primary); font-size:0.85rem;">
                                    <input type="number" id="override-input-bank-count" placeholder="Jml Transaksi" min="0" class="form-control" style="width:100%; padding:0.5rem; border:1px solid var(--border-color); border-radius:var(--radius-sm); background:var(--bg-card); color:var(--text-primary); font-size:0.85rem;">
                                </div>
                            </div>
                            <!-- E-Wallet -->
                            <div style="background:var(--bg-secondary); border:1px solid var(--border-color); border-radius:var(--radius-md); padding:0.75rem;">
                                <div style="font-weight:700; font-size:0.85rem; color:#ec4899; margin-bottom:0.35rem;">
                                    <i class="fas fa-mobile-alt"></i> Saldo E-Wallet
                                </div>
                                <div style="display:flex; flex-direction:column; gap:0.35rem;">
                                    <input type="number" id="override-input-ewallet-total" placeholder="Nominal Rp" min="0" step="1000" class="form-control" style="width:100%; padding:0.5rem; border:1px solid var(--border-color); border-radius:var(--radius-sm); background:var(--bg-card); color:var(--text-primary); font-size:0.85rem;">
                                    <input type="number" id="override-input-ewallet-count" placeholder="Jml Transaksi" min="0" class="form-control" style="width:100%; padding:0.5rem; border:1px solid var(--border-color); border-radius:var(--radius-sm); background:var(--bg-card); color:var(--text-primary); font-size:0.85rem;">
                                </div>
                            </div>
                        </div>
                    </div>

                    <div style="display:flex; align-items:center; justify-content:space-between; gap:0.75rem; flex-wrap:wrap; border-top:1px solid var(--border-color); padding-top:1rem;">
                        <button type="button" class="btn btn-outline btn-sm" id="btn-reset-financial-override" style="color:#ef4444; border-color:#ef4444;">
                            <i class="fas fa-undo"></i> Kembalikan ke Hitungan Otomatis Database
                        </button>
                        <div style="display:flex; gap:0.5rem;">
                            <button type="button" class="btn btn-outline" onclick="UI.closeModal('modal-financial-override')">Tutup</button>
                            <button type="submit" class="btn btn-primary" style="background:#6366f1; border-color:#6366f1; font-weight:700;">
                                <i class="fas fa-save"></i> Simpan & Terapkan Nominal
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Toast Notifications Container -->
    <div class="toast-container" id="toast-container"></div>

    <!-- Scripts -->
    <script src="../js/security.js"></script>
    <script src="../js/prices-data.js"></script>
    <script src="../js/images-data.js"></script>
    <script src="../js/products-data.js"></script>
    <script src="../js/admin.js"></script>
    <script src="../js/ui.js"></script>
    <script>
        // Check admin session
        function checkAdminAuth() {
            const session = Security.getActiveSession();
            if (session && session.role === 'admin') {
                document.getElementById('admin-login-gate').style.display = 'none';
                document.getElementById('admin-app').style.display = 'block';
                const nameDisplay = document.getElementById('admin-name-display');
                if (nameDisplay && session.name) {
                    nameDisplay.textContent = session.name;
                }
                AdminModule.render();
            } else {
                document.getElementById('admin-login-gate').style.display = 'flex';
                document.getElementById('admin-app').style.display = 'none';
            }
        }

        // Quick Auto-Fill Demo Button
        const quickFillBtn = document.getElementById('btn-quick-fill-admin');
        if (quickFillBtn) {
            quickFillBtn.addEventListener('click', () => {
                document.getElementById('admin-user').value = 'admin';
                document.getElementById('admin-pass').value = 'admin123';
                document.getElementById('admin-login-form').dispatchEvent(new Event('submit'));
            });
        }

        // Toggle Password Visibility
        const toggleBtn = document.getElementById('btn-toggle-admin-pass');
        if (toggleBtn) {
            toggleBtn.addEventListener('click', () => {
                const passInput = document.getElementById('admin-pass');
                const icon = toggleBtn.querySelector('i');
                if (passInput.type === 'password') {
                    passInput.type = 'text';
                    icon.className = 'fas fa-eye-slash';
                } else {
                    passInput.type = 'password';
                    icon.className = 'fas fa-eye';
                }
            });
        }

        // Login form
        document.getElementById('admin-login-form').addEventListener('submit', async (e) => {
            e.preventDefault();
            const alertBox = document.getElementById('admin-login-alert');
            const submitBtn = document.getElementById('btn-submit-admin');
            const u = document.getElementById('admin-user').value.trim();
            const p = document.getElementById('admin-pass').value.trim();

            if (!u || !p) {
                alertBox.innerHTML = `
                    <div class="alert alert-error"><i class="fas fa-exclamation-circle"></i> Username dan password wajib diisi!</div>
                `;
                return;
            }

            submitBtn.disabled = true;
            submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Memverifikasi Kredensial...';

            try {
                // Try REST API login
                const res = await fetch('/api/login', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ identifier: u, password: p })
                });
                const data = await res.json();

                if (data.success && data.user && data.user.role === 'admin') {
                    Security.setActiveSession(data.user);
                    checkAdminAuth();
                    return;
                }
            } catch (err) {
                console.warn('API login error, proceeding to direct check:', err);
            }

            // Direct validation fallback
            const cleanUser = u.toLowerCase();
            if ((cleanUser === 'admin' || cleanUser === 'admin@digitalmedia.co.id' || cleanUser === '081122334455') && p === 'admin123') {
                Security.setActiveSession({
                    id: 'USR-001',
                    userId: 'USR-001',
                    role: 'admin',
                    username: 'admin',
                    name: 'Bapak Hendra (Master Admin)',
                    email: 'admin@digitalmedia.co.id',
                    phone: '081122334455'
                });
                checkAdminAuth();
            } else {
                submitBtn.disabled = false;
                submitBtn.innerHTML = '<i class="fas fa-sign-in-alt"></i> Masuk ke Dashboard Admin';
                alertBox.innerHTML = `
                    <div class="alert alert-error">
                        <i class="fas fa-exclamation-circle"></i> Username atau password admin salah!
                        <div style="margin-top:0.35rem; font-size:0.82rem;">Pastikan menggunakan <strong>admin</strong> dan <strong>admin123</strong>, atau klik tombol kuning di atas.</div>
                    </div>
                `;
            }
        });

        // Logout
        document.getElementById('btn-admin-logout').addEventListener('click', () => {
            Security.clearSession();
            checkAdminAuth();
        });

        document.addEventListener('DOMContentLoaded', checkAdminAuth);
    </script>
</body>
</html>
