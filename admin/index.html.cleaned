            <button type="button" class="quick-demo-pill" id="btn-quick-fill-admin" title="Klik untuk langsung mengisi username dan password admin">
                <i class="fas fa-bolt" style="color:#eab308;"></i>
                <span>Klik untuk Isi Otomatis & Masuk: <strong>admin</strong> / <strong>admin123</strong></span>
            </button>

            <!-- Alert Container -->
            <div id="admin-login-alert" style="margin-bottom:1rem;"></div>

            <!-- Login Form -->
            <form id="admin-login-form">
                <div class="form-group">
                    <label for="admin-user">Username / Email Admin</label>
                    <div style="position:relative;">
                        <input type="text" id="admin-user" required placeholder="admin atau admin@digitalmedia.co.id" style="padding-left:2.5rem;" autocomplete="username">
                        <i class="fas fa-user-shield" style="position:absolute; left:0.95rem; top:50%; transform:translateY(-50%); color:var(--text-tertiary); font-size:0.95rem;"></i>
