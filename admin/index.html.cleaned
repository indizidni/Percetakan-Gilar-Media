                        <div style="font-size:0.68rem; font-family:var(--font-mono); letter-spacing:2px; color:#475569; font-weight:700;" id="inv-barcode-text">* DM-0000 *</div>
                    </div>
                </div>

                <!-- Tanda Tangan Kasir & Pelanggan -->
                <div class="invoice-signatures">
                    <div>
