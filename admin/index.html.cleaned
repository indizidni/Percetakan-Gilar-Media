    <!-- Modal Admin Catat Kas Masuk / Suntikan Uang Kembalian -->
    <div class="modal-overlay" id="admin-modal-cash-in">
        <div class="modal" style="max-width: 460px;">
            <div class="modal-header">
                <h3><i class="fas fa-plus-circle" style="color:var(--success);"></i> Tambah Kas Masuk / Suntikan Kembalian</h3>
                <button type="button" class="modal-close" data-modal-close><i class="fas fa-times"></i></button>
            </div>
            <div class="modal-body" style="padding: 1.25rem;">
                <form id="admin-form-cash-in">
                    <div style="margin-bottom:1rem;">
                        <label style="display:block; font-size:0.85rem; font-weight:700; margin-bottom:0.35rem;">Nominal Kas Masuk (Rp) *</label>
                        <div style="display:flex; gap:0.4rem; margin-bottom:0.5rem; flex-wrap:wrap;">
                            <button type="button" class="btn btn-outline btn-sm btn-admin-quick-in" data-amt="50000">+50rb</button>
                            <button type="button" class="btn btn-outline btn-sm btn-admin-quick-in" data-amt="100000">+100rb</button>
                            <button type="button" class="btn btn-outline btn-sm btn-admin-quick-in" data-amt="200000">+200rb</button>
                            <button type="button" class="btn btn-outline btn-sm btn-admin-quick-in" data-amt="500000">+500rb</button>
                        </div>
                        <input type="number" id="admin-input-cash-in-amt" required placeholder="Contoh: 100000" min="1000"
                               style="width:100%; padding:0.75rem; border:1px solid var(--border-color); border-radius:var(--radius-md); background:var(--bg-secondary); color:var(--text-primary); font-size:1.1rem; font-weight:800;">
                    </div>
                    <div style="margin-bottom:1rem;">
                        <label style="display:block; font-size:0.85rem; font-weight:700; margin-bottom:0.35rem;">Kategori Pemasukan</label>
                        <select id="admin-select-cash-in-cat" style="width:100%; padding:0.65rem; border:1px solid var(--border-color); border-radius:var(--radius-md); background:var(--bg-secondary); color:var(--text-primary); font-size:0.85rem;">
                            <option value="Suntikan Uang Kembalian dari Pemilik" selected>Suntikan Uang Kembalian dari Pemilik</option>
                            <option value="Penerimaan Tunai Piutang / Pelunasan Manual">Penerimaan Tunai Piutang / Pelunasan Manual</option>
                            <option value="Sisa Pengembalian Belanja Toko">Sisa Pengembalian Belanja Toko</option>
                            <option value="Pemasukan Kas Toko Lainnya">Pemasukan Kas Toko Lainnya</option>
                        </select>
                    </div>
                    <div style="margin-bottom:1.25rem;">
                        <label style="display:block; font-size:0.85rem; font-weight:700; margin-bottom:0.35rem;">Keterangan / Catatan *</label>
                        <input type="text" id="admin-input-cash-in-notes" required placeholder="Contoh: Tambahan modal uang kembalian pecahan kecil untuk kasir"
                               style="width:100%; padding:0.65rem; border:1px solid var(--border-color); border-radius:var(--radius-md); background:var(--bg-secondary); color:var(--text-primary); font-size:0.85rem;">
                    </div>
                    <button type="submit" class="btn btn-success btn-block btn-lg" style="font-weight:800;">
                        <i class="fas fa-check-circle"></i> Tambahkan ke Laci Toko
                    </button>
                </form>
            </div>
        </div>
    </div>

    </div>




