                    </div>
                    <div style="margin-bottom:1rem;">
                        <label style="display:block; font-size:0.85rem; font-weight:700; margin-bottom:0.35rem;">Kategori Pengeluaran</label>
                        <select id="admin-select-cash-out-cat" style="width:100%; padding:0.65rem; border:1px solid var(--border-color); border-radius:var(--radius-md); background:var(--bg-secondary); color:var(--text-primary); font-size:0.85rem;">
                            <option value="Beli Perlengkapan Packing (Lakban/ATK)" selected>Beli Perlengkapan Packing (Lakban/ATK)</option>
