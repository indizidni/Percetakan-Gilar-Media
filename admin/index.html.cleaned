                <div class="logo-badge-cmyk" style="margin:0 auto 1.25rem; width:56px; height:56px; font-size:1.6rem; background:linear-gradient(135deg,#6366f1,#4f46e5); box-shadow:0 8px 25px rgba(99,102,241,0.35);">
                    <i class="fas fa-shield-alt"></i>
                </div>
