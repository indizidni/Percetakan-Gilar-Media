                    <thead>
                        <tr>
                            <th style="width: 35px; text-align:center;">No</th>
                            <th>Item Layanan & Spesifikasi Cetak</th>
                            <th style="text-align: center; width: 60px;">Qty</th>
                            <th style="text-align: right; width: 110px;">Harga Satuan</th>
                            <th style="text-align: right; width: 120px;">Subtotal</th>
                        </tr>
                    </thead>
                    <tbody id="inv-items-tbody"></tbody>
                </table>

                <!-- Ringkasan Finansial & Catatan Ketentuan -->
                <div class="invoice-summary-box">
                    <div class="invoice-notes">
                        <strong>SYARAT & KETENTUAN PERCETAKAN:</strong>
                        <ol>
                            <li>Hasil cetak dikerjakan sesuai file desain yang telah disetujui (ACC).</li>
                            <li>Pesanan DP 50% wajib dilunasi sebelum barang diambil/dikirim.</li>
                            <li>Komplain hasil cetak maksimal 1x24 jam sejak pesanan diterima dengan menyertakan nota ini.</li>
                        </ol>
                    </div>
                    <div class="invoice-totals">
                        <div class="invoice-totals-row">
                            <span>Subtotal Item</span>
                            <span id="inv-subtotal">Rp 0</span>
                        </div>
                        <div class="invoice-totals-row">
                            <span>Biaya Finishing & Desain</span>
                            <span>Termasuk</span>
                        </div>
                        <div class="invoice-totals-row grand-total">
                            <span>TOTAL TAGIHAN</span>
                            <span id="inv-total">Rp 0</span>
                        </div>
                        <div class="invoice-totals-row highlight-dp" id="inv-row-dp">
                            <span>Uang Muka (DP 50%) Diterima</span>
                            <span id="inv-dp-paid">Rp 0</span>
                        </div>
                        <div class="invoice-totals-row highlight-sisa" id="inv-row-sisa">
                            <span>SISA TAGIHAN / PIUTANG</span>
                            <span id="inv-remaining">Rp 0</span>
                        </div>
                    </div>
                </div>

                <!-- Stempel Validasi & Barcode Nota Resmi -->
                <div style="display:flex; justify-content:space-between; align-items:center; margin:1.25rem 0; padding:0.75rem 1rem; background:#f8fafc; border:1px dashed #cbd5e1; border-radius:6px; flex-wrap:wrap; gap:1rem;">
                    <div>
                        <div id="inv-stamp-badge" style="display:inline-block; padding:4px 14px; border:2px solid #16a34a; color:#16a34a; font-weight:900; font-size:0.85rem; letter-spacing:1.5px; border-radius:4px; text-transform:uppercase;">
                            LUNAS / VERIFIED
                        </div>
                        <div style="font-size:0.72rem; color:#64748b; margin-top:4px;">
                            <i class="fas fa-shield-alt" style="color:#4f46e5;"></i> Terverifikasi Digital oleh Sistem Kasir & Admin Digital Media
