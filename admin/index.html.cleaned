                        <i class="fas fa-user-shield" style="position:absolute; left:0.95rem; top:50%; transform:translateY(-50%); color:var(--text-tertiary); font-size:0.95rem;"></i>
                    </div>
                </div>

                <div class="form-group">
                    <label for="admin-pass">Kata Sandi</label>
                    <div class="input-password-wrap" style="position:relative;">
                        <input type="password" id="admin-pass" required placeholder="Masukkan kata sandi admin" style="padding-left:2.5rem; padding-right:2.85rem;" autocomplete="current-password">
                        <i class="fas fa-lock" style="position:absolute; left:0.95rem; top:50%; transform:translateY(-50%); color:var(--text-tertiary); font-size:0.95rem;"></i>
                        <button type="button" class="btn-toggle-password" id="btn-toggle-admin-pass" aria-label="Tampilkan / Sembunyikan Kata Sandi">
                            <i class="fas fa-eye"></i>
                        </button>
                    </div>
                </div>

