                    </div>
                    <div class="invoice-meta-col">
                        <p><strong>DETAIL TRANSAKSI:</strong></p>
                        <p>Saluran Pesanan: <strong id="inv-channel">-</strong></p>
                        <p>Metode Pembayaran: <strong id="inv-pay-method">-</strong></p>
                        <p>Status Pelunasan: <span id="inv-pay-status-badge">-</span></p>
                        <p>Petugas Kasir / Admin: <span id="inv-cashier">-</span></p>
                    </div>
                </div>

