                    </div>
                    <div class="invoice-title-block">
                        <h1>NOTA INVOICE</h1>
                        <p style="font-size: 0.92rem; font-weight: 800; color: #1e293b; margin:0;" id="inv-order-id">DM-ONL-0000</p>
